{
  "name": "cdc-study (polling vs CDC)",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb"
  },
  "postCreateCommand": "pip install -r requirements.txt",
  "forwardPorts": [1433, 5432],
  "portsAttributes": {
    "1433": { "label": "SQL Server", "onAutoForward": "silent" },
    "5432": { "label": "Postgres (destino)", "onAutoForward": "silent" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-mssql.mssql"
      ]
    }
  }
}